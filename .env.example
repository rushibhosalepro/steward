FALKORDB_URL=falkor://localhost:6379
PORT=8787

# ── Planner ─────────────────────────────────────────────────────────────────────────
# Which planner to use: auto | offline | claude | xai | gemini | groq | openrouter | ollama
# auto = Claude if its key is set, else the first configured provider (xai, gemini, groq,
# openrouter, ollama), else the offline planner. Any LLM failure falls back to offline.
STEWARD_PLANNER=auto

# Anthropic (Claude)
ANTHROPIC_API_KEY=
STEWARD_MODEL=claude-opus-5-5

# xAI (Grok)
XAI_API_KEY=
STEWARD_MODEL_XAI=grok-4

# Google Gemini (OpenAI-compatible endpoint; has a free tier)
GEMINI_API_KEY=
STEWARD_MODEL_GEMINI=gemini-2.5-flash

# Groq (free tier)
GROQ_API_KEY=
STEWARD_MODEL_GROQ=llama-3.3-70b-versatile

# OpenRouter (pick any ":free" model)
OPENROUTER_API_KEY=
STEWARD_MODEL_OPENROUTER=meta-llama/llama-3.3-70b-instruct:free

# Ollama (local, free, no key): set OLLAMA_ENABLED=1 after `ollama pull <model>`
OLLAMA_ENABLED=
OLLAMA_BASE_URL=http://localhost:11434/v1
STEWARD_MODEL_OLLAMA=llama3.1
