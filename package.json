{
  "name": "steward",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "bun run --cwd apps/web build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d falkordb",
    "db:down": "docker compose down",
    "start": "bun apps/api/src/index.ts"
  },
  "devDependencies": {
    "turbo": "^2.11.8",
    "typescript": "^7.0.2"
  }
}
